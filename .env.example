# Flask / SocketIO secret key (required in production)
SECRET_KEY=change-me-in-production

# Environment: development | production
FLASK_ENV=development

# Server port (default: 8000)
PORT=8000

# Comma-separated list of allowed CORS origins for WebSocket
# Example: https://hand-motion-pipeline.onrender.com,http://localhost:8000
ALLOWED_ORIGINS=https://hand-motion-pipeline.onrender.com

# MediaPipe/TensorFlow log level (3 = errors only)
TF_CPP_MIN_LOG_LEVEL=3
